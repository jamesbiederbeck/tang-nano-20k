// buttons S1 (next seed) and S2 (previous seed); the design finds the active level itself
IO_LOC "btn[0]" 88;
IO_LOC "btn[1]" 87;
IO_PORT "btn[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "btn[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
